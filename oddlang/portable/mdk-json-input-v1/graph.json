{
  "format": "oddlang-bounded-json-input-v1",
  "id": "urn:marmish:mdk:synthetic-metadata:v1",
  "maximumValueBytes": 65536,
  "maximumRecords": 200,
  "framing": "lf-terminated",
  "sizeBoundary": "include-delimiter",
  "duplicateMembers": "last-value",
  "guardOrder": [
    "byte-limit",
    "record-limit",
    "parse"
  ],
  "capacityError": "urn:marmish:mdk:adapter-error:v1:variant:OutputLimit",
  "invalidError": "urn:marmish:mdk:adapter-error:v1:variant:InvalidResponse"
}