@prefix o: <urn:oddlang:structural-ownership:> .
@prefix m: <urn:marmish:structure:core:> .
@prefix binding: <urn:marmish:binding:rust:core:> .
@prefix facade: <urn:oddlang:facade:> .
@prefix evidence: <https://github.com/Epiphytic/marmish-oddlang/blob/10926d822bb9aa3a16b20ef35cfc63bebd586780/verification/whole/core-lexical/> .

m:package a o:Package ;
    o:originalFacade facade:root .
m:configuration a o:Module ;
    o:owner m:package ;
    o:originalFacade facade:module:config .
m:probe-framing a o:Module ;
    o:owner m:package ;
    o:originalFacade facade:module:frame .

m:canonical-member a o:PinnedMembership ;
    o:member m:package ;
    o:workspaceLock <https://github.com/Epiphytic/marmish-oddlang/blob/036349fc69ab5b850df2006c16ec2518be95a254/oddlang/portable/workspace-v7-canonical-offline/workspace.lock> ;
    o:workspaceLockSha256 "5abf57c811d641ba126c32dde208334d85d47374bbfbb983231783a403f24df4" ;
    o:packageManifest <https://github.com/Epiphytic/marmish-oddlang/blob/036349fc69ab5b850df2006c16ec2518be95a254/oddlang/portable/core-package.json> ;
    o:packageManifestSha256 "89292d721acd668379be55e762b963bfac16f0c57fad916c450ca14f0658e1d4" ;
    o:standaloneLock evidence:package.lock ;
    o:standaloneLockSha256 "b30e3ad85232743da965f0ca1d823baea25095d66e883005ceb1f790ee44794c" ;
    o:comparison evidence:comparison.json ;
    o:darwinReceipt <https://github.com/Epiphytic/marmish-oddlang/blob/10926d822bb9aa3a16b20ef35cfc63bebd586780/verification/whole/core-lexical/aarch64-apple-darwin/receipt.json> ;
    o:linuxReceipt <https://github.com/Epiphytic/marmish-oddlang/blob/10926d822bb9aa3a16b20ef35cfc63bebd586780/verification/whole/core-lexical/aarch64-unknown-linux-gnu/receipt.json> ;
    o:originalFacadeGraph <https://github.com/Epiphytic/marmish-oddlang/blob/2c45e8375690c9ff8f25023bf000ced3b16a6762/oddlang/facade/domain.ttl> ;
    o:originalFacadeLock <https://github.com/Epiphytic/marmish-oddlang/blob/2c45e8375690c9ff8f25023bf000ced3b16a6762/oddlang/facade/import.lock> .

m:retention-domain a o:Component ;
    o:inMember m:canonical-member ;
    o:componentKind "value-domain" ;
    o:graph <https://github.com/Epiphytic/marmish-oddlang/blob/036349fc69ab5b850df2006c16ec2518be95a254/oddlang/portable/core-config-v1/domain.ttl> ;
    o:graphSha256 "47a043d5e93b577ed7e59c6ce6e2e04b3988a92af18436cac2e61828d226d1bc" ;
    o:rustOverlay <https://github.com/Epiphytic/marmish-oddlang/blob/036349fc69ab5b850df2006c16ec2518be95a254/oddlang/portable/core-config-v1/rust.json> ;
    o:rustOverlaySha256 "e40105ffefb5cb6d62df6705c0b248e1bacf6e1e36d8c9bca6e4756b184155e5" .

m:probe-envelope-domain a o:Component ;
    o:inMember m:canonical-member ;
    o:componentKind "json-envelope" ;
    o:graph <https://github.com/Epiphytic/marmish-oddlang/blob/036349fc69ab5b850df2006c16ec2518be95a254/oddlang/portable/core-frame-v1/domain.ttl> ;
    o:graphSha256 "a3429c691990835d1ee3ad13e90ce56fbcc15d84f28c6a2eedcf7f7135b9a0e8" ;
    o:rustOverlay <https://github.com/Epiphytic/marmish-oddlang/blob/036349fc69ab5b850df2006c16ec2518be95a254/oddlang/portable/core-frame-v1/rust.json> ;
    o:rustOverlaySha256 "325f13b37cb311aefdf0348b26b897785cdc9ebb78bba22965b0c267adb8318d" .

m:relay-set-domain a o:Component ;
    o:inMember m:canonical-member ;
    o:componentKind "endpoint-set" ;
    o:graph <https://github.com/Epiphytic/marmish-oddlang/blob/036349fc69ab5b850df2006c16ec2518be95a254/oddlang/portable/core-relays-v1/graph.json> ;
    o:graphSha256 "98a204fcc53e7809fc5c79938e651a1df9d30bf7d650b40abee55805b597beff" ;
    o:rustOverlay <https://github.com/Epiphytic/marmish-oddlang/blob/036349fc69ab5b850df2006c16ec2518be95a254/oddlang/portable/core-relays-v1/rust.json> ;
    o:rustOverlaySha256 "e81c31da8d756d441600e3012d5217e89531b7c054b3c5172eed1747cd0f260c" .

m:configuration-failure a o:Type ;
    o:owner m:configuration ;
    o:declarationKind "sum" .
binding:configuration-failure a o:RustBinding ;
    o:type m:configuration-failure ;
    o:component m:retention-domain ;
    o:originalFacade facade:type:config:ConfigError ;
    o:exportSpelling "ConfigError" ;
    o:exportRole "crate-root public data reexport" ;
    o:originalPath "marmish_core::config::ConfigError" ;
    o:generatedPath "marmish_core::config::__projection_0::ConfigError" .

m:framing-failure a o:Type ;
    o:owner m:probe-framing ;
    o:declarationKind "sum" .
binding:framing-failure a o:RustBinding ;
    o:type m:framing-failure ;
    o:component m:probe-envelope-domain ;
    o:originalFacade facade:type:frame:FrameError ;
    o:exportSpelling "FrameError" ;
    o:exportRole "crate-root public data reexport" ;
    o:originalPath "marmish_core::frame::FrameError" ;
    o:generatedPath "marmish_core::frame::__projection_2::FrameError" .

m:frame-limits a o:Type ;
    o:owner m:probe-framing ;
    o:declarationKind "record" .
binding:frame-limits a o:RustBinding ;
    o:type m:frame-limits ;
    o:component m:probe-envelope-domain ;
    o:originalFacade facade:type:frame:Limits ;
    o:exportSpelling "Limits" ;
    o:exportRole "crate-root public data reexport" ;
    o:originalPath "marmish_core::frame::Limits" ;
    o:generatedPath "marmish_core::frame::__projection_2::Limits" .

m:probe-envelope a o:Type ;
    o:owner m:probe-framing ;
    o:declarationKind "record" .
binding:probe-envelope a o:RustBinding ;
    o:type m:probe-envelope ;
    o:component m:probe-envelope-domain ;
    o:originalFacade facade:type:frame:ProbeEnvelope ;
    o:exportSpelling "ProbeEnvelope" ;
    o:exportRole "crate-root public data reexport" ;
    o:originalPath "marmish_core::frame::ProbeEnvelope" ;
    o:generatedPath "marmish_core::frame::__projection_2::ProbeEnvelope" .

m:relay-set a o:Type ;
    o:owner m:configuration ;
    o:declarationKind "record" .
binding:relay-set a o:RustBinding ;
    o:type m:relay-set ;
    o:component m:relay-set-domain ;
    o:originalFacade facade:type:config:RelaySet ;
    o:exportSpelling "RelaySet" ;
    o:exportRole "crate-root public data reexport" ;
    o:originalPath "marmish_core::config::RelaySet" ;
    o:generatedPath "marmish_core::config::__projection_1::RelaySet" .

m:retention-policy a o:Type ;
    o:owner m:configuration ;
    o:declarationKind "record" .
binding:retention-policy a o:RustBinding ;
    o:type m:retention-policy ;
    o:component m:retention-domain ;
    o:originalFacade facade:type:config:Retention ;
    o:exportSpelling "Retention" ;
    o:exportRole "crate-root public data reexport" ;
    o:originalPath "marmish_core::config::Retention" ;
    o:generatedPath "marmish_core::config::__projection_0::Retention" .

# Direct semantic correspondence, independent of the optional native bindings.
@prefix config: <urn:marmish:core:configuration:> .
@prefix frame: <urn:marmish:core:frame:> .
@prefix core: <urn:oddlang:core:> .

m:retention-policy o:semanticComponent m:retention-domain ; o:domain config:retention .
m:relay-set o:semanticComponent m:relay-set-domain ; o:domain config:relaySet .
m:probe-envelope o:semanticComponent m:probe-envelope-domain ; o:domain frame:probe .

m:configuration-failure o:semanticComponent m:retention-domain ;
    o:errorCase config:DisallowedComponents, config:DisallowedHost, config:DisallowedScheme,
        config:EmptyRelaySet, config:InvalidUrl, config:LoopbackDenied, config:RetentionOutOfRange .
m:framing-failure o:semanticComponent m:probe-envelope-domain ;
    o:errorCase frame:SizeLimit, frame:InvalidJson, frame:InvalidVersion, frame:InvalidEncoding .

m:frame-limits o:semanticComponent m:probe-envelope-domain ; o:parameterSubject frame:probe ;
    o:parameterPredicate core:rawBytes, core:wireBytes, core:recordLineBytes .
