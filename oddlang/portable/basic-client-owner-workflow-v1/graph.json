{
  "format": "oddlang-local-command-workflow-v1",
  "id": "urn:marmish:local-command-client:submit",
  "socket_argument": "socket",
  "discovery": {
    "id": "urn:marmish:ipc:endpoint:provider",
    "state_argument": "state_dir",
    "profile_argument": "identity",
    "default_profile": "default",
    "state_sources": [
      {
        "variable": "XDG_DATA_HOME",
        "platform": "linux",
        "require_absolute": true,
        "suffix": [
          "marmish",
          "v2"
        ]
      },
      {
        "variable": "HOME",
        "platform": "macos",
        "require_absolute": false,
        "suffix": [
          "Library",
          "Application Support",
          "Marmish",
          "v2"
        ]
      },
      {
        "variable": "HOME",
        "require_absolute": false,
        "suffix": [
          ".local",
          "share",
          "marmish",
          "v2"
        ]
      }
    ],
    "missing_state": {
      "exit": 1,
      "stderr": "marmish: invalid input: home_directory"
    },
    "profile_atom": {
      "maximum_bytes": 64,
      "punctuation": "_-",
      "invalid": {
        "exit": 1,
        "stderr": "marmish: identity: invalid_profile_name"
      }
    },
    "private_directory_mode": 448,
    "private_file_mode": 384,
    "unsafe_directory": {
      "exit": 1,
      "stderr": "marmish: identity: unsafe_profile_path"
    },
    "unsafe_file": {
      "exit": 1,
      "stderr": "marmish: identity: unsafe_profile_file"
    },
    "profile": {
      "id": "urn:marmish:ipc:endpoint:profile",
      "leaf": "profile.json",
      "maximum_bytes": 8192,
      "overflow": "reject",
      "missing": {
        "exit": 1,
        "stderr": "marmish: identity: missing_manifest"
      },
      "invalid": {
        "exit": 1,
        "stderr": "marmish: identity: invalid_manifest"
      },
      "fields": [
        {
          "id": "urn:marmish:ipc:endpoint:profile:format",
          "key": "format",
          "type": {
            "kind": "unsigned_byte"
          }
        },
        {
          "id": "urn:marmish:ipc:endpoint:profile:profile_id",
          "key": "profile_id",
          "type": {
            "kind": "text"
          }
        },
        {
          "id": "urn:marmish:ipc:endpoint:profile:name",
          "key": "name",
          "type": {
            "kind": "text"
          }
        },
        {
          "id": "urn:marmish:ipc:endpoint:profile:transaction",
          "key": "transaction",
          "type": {
            "kind": "text"
          }
        },
        {
          "id": "urn:marmish:ipc:endpoint:profile:phase",
          "key": "phase",
          "type": {
            "kind": "strings",
            "values": [
              "initializing",
              "ready"
            ]
          }
        },
        {
          "id": "urn:marmish:ipc:endpoint:profile:backend",
          "key": "backend",
          "type": {
            "kind": "strings",
            "values": [
              "keychain",
              "files"
            ]
          }
        },
        {
          "id": "urn:marmish:ipc:endpoint:profile:nostr_ref",
          "key": "nostr_ref",
          "type": {
            "kind": "text"
          }
        },
        {
          "id": "urn:marmish:ipc:endpoint:profile:sqlcipher_ref",
          "key": "sqlcipher_ref",
          "type": {
            "kind": "text"
          }
        },
        {
          "id": "urn:marmish:ipc:endpoint:profile:device_slot",
          "key": "device_slot",
          "type": {
            "kind": "text"
          }
        },
        {
          "id": "urn:marmish:ipc:endpoint:profile:public_key",
          "key": "public_key",
          "type": {
            "kind": "nullable_text"
          }
        }
      ],
      "checks": [
        {
          "id": "urn:marmish:ipc:endpoint:check:profile-format",
          "require": {
            "kind": "equal",
            "left": {
              "kind": "profile_field",
              "id": "urn:marmish:ipc:endpoint:profile:format"
            },
            "right": {
              "kind": "unsigned_byte",
              "value": 2
            }
          },
          "rejected": {
            "exit": 1,
            "stderr": "marmish: storage: incompatible_state"
          }
        },
        {
          "id": "urn:marmish:ipc:endpoint:check:profile-name",
          "require": {
            "kind": "equal",
            "left": {
              "kind": "profile_field",
              "id": "urn:marmish:ipc:endpoint:profile:name"
            },
            "right": {
              "kind": "profile_name"
            }
          },
          "rejected": {
            "exit": 1,
            "stderr": "marmish: identity: invalid_manifest"
          }
        },
        {
          "id": "urn:marmish:ipc:endpoint:check:profile_id",
          "require": {
            "kind": "lower_hex",
            "value": {
              "kind": "profile_field",
              "id": "urn:marmish:ipc:endpoint:profile:profile_id"
            },
            "bytes": 16,
            "nullable": false
          },
          "rejected": {
            "exit": 1,
            "stderr": "marmish: identity: invalid_manifest"
          }
        },
        {
          "id": "urn:marmish:ipc:endpoint:check:transaction",
          "require": {
            "kind": "lower_hex",
            "value": {
              "kind": "profile_field",
              "id": "urn:marmish:ipc:endpoint:profile:transaction"
            },
            "bytes": 16,
            "nullable": false
          },
          "rejected": {
            "exit": 1,
            "stderr": "marmish: identity: invalid_manifest"
          }
        },
        {
          "id": "urn:marmish:ipc:endpoint:check:nostr_ref",
          "require": {
            "kind": "lower_hex",
            "value": {
              "kind": "profile_field",
              "id": "urn:marmish:ipc:endpoint:profile:nostr_ref"
            },
            "bytes": 32,
            "nullable": false
          },
          "rejected": {
            "exit": 1,
            "stderr": "marmish: identity: invalid_manifest"
          }
        },
        {
          "id": "urn:marmish:ipc:endpoint:check:sqlcipher_ref",
          "require": {
            "kind": "lower_hex",
            "value": {
              "kind": "profile_field",
              "id": "urn:marmish:ipc:endpoint:profile:sqlcipher_ref"
            },
            "bytes": 32,
            "nullable": false
          },
          "rejected": {
            "exit": 1,
            "stderr": "marmish: identity: invalid_manifest"
          }
        },
        {
          "id": "urn:marmish:ipc:endpoint:check:distinct-ref",
          "require": {
            "kind": "different",
            "left": {
              "kind": "profile_field",
              "id": "urn:marmish:ipc:endpoint:profile:nostr_ref"
            },
            "right": {
              "kind": "profile_field",
              "id": "urn:marmish:ipc:endpoint:profile:sqlcipher_ref"
            }
          },
          "rejected": {
            "exit": 1,
            "stderr": "marmish: identity: invalid_manifest"
          }
        },
        {
          "id": "urn:marmish:ipc:endpoint:check:device-slot",
          "require": {
            "kind": "lower_hex",
            "value": {
              "kind": "profile_field",
              "id": "urn:marmish:ipc:endpoint:profile:device_slot"
            },
            "bytes": 16,
            "nullable": false
          },
          "rejected": {
            "exit": 1,
            "stderr": "marmish: identity: invalid_manifest"
          }
        },
        {
          "id": "urn:marmish:ipc:endpoint:check:public-key",
          "require": {
            "kind": "lower_hex",
            "value": {
              "kind": "profile_field",
              "id": "urn:marmish:ipc:endpoint:profile:public_key"
            },
            "bytes": 32,
            "nullable": true
          },
          "rejected": {
            "exit": 1,
            "stderr": "marmish: identity: invalid_manifest"
          }
        },
        {
          "id": "urn:marmish:ipc:endpoint:check:ready-key",
          "require": {
            "kind": "different",
            "left": {
              "kind": "profile_field",
              "id": "urn:marmish:ipc:endpoint:profile:public_key"
            },
            "right": {
              "kind": "null"
            }
          },
          "rejected": {
            "exit": 1,
            "stderr": "marmish: identity: invalid_manifest"
          },
          "when": {
            "kind": "equal",
            "left": {
              "kind": "profile_field",
              "id": "urn:marmish:ipc:endpoint:profile:phase"
            },
            "right": {
              "kind": "text",
              "value": "ready"
            }
          }
        }
      ]
    },
    "runtime": [
      {
        "kind": "literal",
        "value": "mr2-"
      },
      {
        "kind": "effective_uid"
      },
      {
        "kind": "literal",
        "value": "-"
      },
      {
        "kind": "profile_field",
        "id": "urn:marmish:ipc:endpoint:profile:profile_id"
      }
    ],
    "binding": {
      "id": "urn:marmish:ipc:endpoint:binding",
      "leaf": "binding.json",
      "maximum_bytes": 8192,
      "overflow": "bounded_prefix",
      "invalid": {
        "exit": 1,
        "stderr": "marmish: identity: runtime_collision"
      },
      "fields": [
        {
          "id": "urn:marmish:ipc:endpoint:binding:format",
          "key": "format",
          "type": {
            "kind": "unsigned_byte"
          }
        },
        {
          "id": "urn:marmish:ipc:endpoint:binding:profile_id",
          "key": "profile_id",
          "type": {
            "kind": "text"
          }
        },
        {
          "id": "urn:marmish:ipc:endpoint:binding:root",
          "key": "root",
          "type": {
            "kind": "text"
          }
        }
      ],
      "checks": [
        {
          "id": "urn:marmish:ipc:endpoint:check:binding-format",
          "require": {
            "kind": "equal",
            "left": {
              "kind": "binding_field",
              "id": "urn:marmish:ipc:endpoint:binding:format"
            },
            "right": {
              "kind": "unsigned_byte",
              "value": 2
            }
          },
          "rejected": {
            "exit": 1,
            "stderr": "marmish: identity: runtime_collision"
          }
        },
        {
          "id": "urn:marmish:ipc:endpoint:check:binding-profile",
          "require": {
            "kind": "equal",
            "left": {
              "kind": "binding_field",
              "id": "urn:marmish:ipc:endpoint:binding:profile_id"
            },
            "right": {
              "kind": "profile_field",
              "id": "urn:marmish:ipc:endpoint:profile:profile_id"
            }
          },
          "rejected": {
            "exit": 1,
            "stderr": "marmish: identity: runtime_collision"
          }
        },
        {
          "id": "urn:marmish:ipc:endpoint:check:binding-root",
          "require": {
            "kind": "equal",
            "left": {
              "kind": "binding_field",
              "id": "urn:marmish:ipc:endpoint:binding:root"
            },
            "right": {
              "kind": "profile_path"
            }
          },
          "rejected": {
            "exit": 1,
            "stderr": "marmish: identity: runtime_collision"
          }
        }
      ]
    },
    "socket_leaf": "s",
    "socket_maximum_exclusive": 104,
    "invalid_runtime_component": {
      "exit": 1,
      "stderr": "marmish: identity: invalid_manifest"
    },
    "socket_too_long": {
      "exit": 1,
      "stderr": "marmish: identity: runtime_path_too_long"
    }
  },
  "profile_inputs": {
    "id": "urn:marmish:local-command-client:authorized-inputs",
    "arguments": {
      "state": "state_dir",
      "profile": "identity",
      "default_profile": "default",
      "relay": "relay",
      "route": "tor",
      "stdin": "stdin",
      "stdin_none": "stdin_none",
      "required_flags": [
        "no_autostart"
      ],
      "excluded_flags": [
        "foreground",
        "new_session"
      ],
      "excluded_values": [
        {
          "id": "user",
          "value_kind": "string"
        },
        {
          "id": "srv",
          "value_kind": "repeated_string"
        },
        {
          "id": "allow_peer",
          "value_kind": "repeated_string"
        },
        {
          "id": "max_commands",
          "value_kind": "string"
        },
        {
          "id": "max_uptime",
          "value_kind": "string"
        }
      ]
    },
    "document": {
      "leaf": "config.json",
      "maximum_bytes": 1048576,
      "directory_mode": 448,
      "file_mode": 384,
      "profile_name_maximum_bytes": 64,
      "profile_name_punctuation": "_-",
      "checks": [
        {
          "field": "version",
          "test": {
            "kind": "one_of",
            "values": [
              1
            ]
          },
          "id": "urn:marmish:local-command-client:profile-check:version"
        },
        {
          "field": "role",
          "test": {
            "kind": "one_of",
            "values": [
              "client",
              "both"
            ]
          },
          "id": "urn:marmish:local-command-client:profile-check:role"
        },
        {
          "field": "execution_clients",
          "test": {
            "kind": "account_set"
          },
          "id": "urn:marmish:local-command-client:profile-check:execution_clients"
        },
        {
          "field": "command_policy",
          "test": {
            "kind": "object"
          },
          "id": "urn:marmish:local-command-client:profile-check:command_policy"
        },
        {
          "field": "cwd",
          "test": {
            "kind": "null_or_absolute_path"
          },
          "id": "urn:marmish:local-command-client:profile-check:cwd"
        },
        {
          "field": "limits",
          "test": {
            "kind": "object"
          },
          "id": "urn:marmish:local-command-client:profile-check:limits"
        },
        {
          "field": "aliases",
          "test": {
            "kind": "object"
          },
          "id": "urn:marmish:local-command-client:profile-check:aliases"
        }
      ],
      "trusted": "trusted_remotes",
      "maximum_accounts": 4096,
      "relay": "relays",
      "route": "tor",
      "maximum_relays": 16,
      "maximum_relay_bytes": 2048,
      "relay_rules": [
        {
          "scheme": "ws",
          "host_suffix": ".onion",
          "routes": [
            "auto",
            "always"
          ],
          "id": "urn:marmish:local-command-client:relay-rule:0",
          "v3_onion": true
        },
        {
          "scheme": "wss",
          "host_suffix": ".onion",
          "routes": [
            "auto",
            "always"
          ],
          "id": "urn:marmish:local-command-client:relay-rule:1",
          "v3_onion": true
        },
        {
          "scheme": "wss",
          "routes": [
            "auto",
            "always",
            "off"
          ],
          "id": "urn:marmish:local-command-client:relay-rule:2",
          "v3_onion": false
        }
      ]
    },
    "payload": {
      "maximum_arguments": 128,
      "maximum_argument_bytes": 16384,
      "maximum_stdin_bytes": 16384,
      "stdin_timeout_ms": 15000,
      "timestamp_bytes": 6,
      "random_bytes": 10
    },
    "outputs": {
      "remote": "remote",
      "relays": "relays",
      "argv": "argv",
      "stdin": "stdin",
      "request": "request_id",
      "invocation": "invocation"
    },
    "errors": {
      "scope": {
        "exit": 125,
        "stderr": "marmish: command client option outside generated handoff scope"
      },
      "path": {
        "exit": 1,
        "stderr": "marmish: identity: unsafe_profile_path"
      },
      "file": {
        "exit": 1,
        "stderr": "marmish: identity: unsafe_profile_file"
      },
      "size": {
        "exit": 1,
        "stderr": "marmish: invalid input: config_size"
      },
      "schema": {
        "exit": 1,
        "stderr": "marmish: invalid input: config_schema"
      },
      "destination": {
        "exit": 1,
        "stderr": "marmish: invalid input: invalid_remote_identity"
      },
      "authority": {
        "exit": 1,
        "stderr": "marmish: invalid input: untrusted_remote"
      },
      "relays": {
        "exit": 1,
        "stderr": "marmish: invalid input: destination_policy_mismatch"
      },
      "separator": {
        "exit": 1,
        "stderr": "marmish: invalid input: command_separator"
      },
      "argv": {
        "exit": 1,
        "stderr": "marmish: invalid input: command_argv"
      },
      "bytes": {
        "exit": 255,
        "stderr": "marmish: command_bytes_limit"
      },
      "stdin_timeout": {
        "exit": 255,
        "stderr": "marmish: command_stdin_timeout"
      },
      "random": {
        "exit": 255,
        "stderr": "marmish: command_id"
      }
    }
  },
  "transport": {
    "deadline_ms": 330000,
    "maximum_frame_bytes": 65536,
    "maximum_exchanges": 3200
  },
  "errors": {
    "binding": {
      "exit": 1,
      "stderr": "marmish: command binding unavailable"
    },
    "io": {
      "exit": 1,
      "stderr": "marmish: local I/O failed"
    },
    "peer": {
      "exit": 255,
      "stderr": "marmish: ipc_peer_uid"
    },
    "frame_size": {
      "exit": 255,
      "stderr": "marmish: ipc_frame_size"
    },
    "frame_json": {
      "exit": 255,
      "stderr": "marmish: ipc_frame_json"
    },
    "deadline": {
      "exit": 255,
      "stderr": "marmish: operation deadline exceeded"
    },
    "protocol": {
      "exit": 255,
      "stderr": "marmish: command_local_response"
    },
    "budget": {
      "exit": 255,
      "stderr": "marmish: local_busy"
    }
  },
  "entry": "urn:marmish:local-command-client:state:status",
  "steps": [
    {
      "id": "urn:marmish:local-command-client:state:status",
      "request": [
        {
          "id": "urn:marmish:local-command-client:field:status:operation",
          "key": "operation",
          "source": {
            "kind": "literal",
            "value": "status"
          }
        }
      ],
      "transitions": [
        {
          "id": "urn:marmish:local-command-client:transition:activation",
          "when": [
            {
              "path": [
                "ok"
              ],
              "equals": true
            },
            {
              "path": [
                "result",
                "state"
              ],
              "equals": "activating"
            }
          ],
          "effect": {
            "kind": "continue",
            "step": "urn:marmish:local-command-client:state:status",
            "delay_ms": 100
          },
          "capture": []
        },
        {
          "id": "urn:marmish:local-command-client:transition:prepare",
          "when": [
            {
              "path": [
                "ok"
              ],
              "equals": true
            }
          ],
          "effect": {
            "kind": "continue",
            "step": "urn:marmish:local-command-client:state:prepare",
            "delay_ms": 0
          },
          "capture": []
        },
        {
          "id": "urn:marmish:local-command-client:transition:status-refusal",
          "when": [],
          "effect": {
            "kind": "exit",
            "status": 1,
            "stderr": "marmish: invalid input: daemon_status"
          }
        }
      ]
    },
    {
      "id": "urn:marmish:local-command-client:state:prepare",
      "request": [
        {
          "id": "urn:marmish:local-command-client:field:prepare:operation",
          "key": "operation",
          "source": {
            "kind": "literal",
            "value": "command_prepare"
          }
        },
        {
          "id": "urn:marmish:local-command-client:field:prepare:remote",
          "key": "remote",
          "source": {
            "kind": "input",
            "name": "remote"
          }
        },
        {
          "id": "urn:marmish:local-command-client:field:prepare:relays",
          "key": "relays",
          "source": {
            "kind": "input",
            "name": "relays"
          }
        }
      ],
      "transitions": [
        {
          "id": "urn:marmish:local-command-client:transition:prepare-busy",
          "when": [
            {
              "path": [
                "ok"
              ],
              "equals": true
            },
            {
              "path": [
                "result"
              ],
              "equals": null
            },
            {
              "path": [
                "error"
              ],
              "equals": null
            },
            {
              "path": [
                "command",
                "state"
              ],
              "equals": "local_busy"
            }
          ],
          "effect": {
            "kind": "continue",
            "step": "urn:marmish:local-command-client:state:prepare",
            "delay_ms": 100
          },
          "capture": []
        },
        {
          "id": "urn:marmish:local-command-client:transition:submit",
          "when": [
            {
              "path": [
                "ok"
              ],
              "equals": true
            },
            {
              "path": [
                "result"
              ],
              "equals": null
            },
            {
              "path": [
                "error"
              ],
              "equals": null
            },
            {
              "path": [
                "command",
                "state"
              ],
              "equals": "ready"
            }
          ],
          "effect": {
            "kind": "continue",
            "step": "urn:marmish:local-command-client:state:submit",
            "delay_ms": 0
          },
          "capture": [
            {
              "name": "session",
              "path": [
                "command",
                "session"
              ],
              "value_kind": {
                "kind": "lower_hex",
                "bytes": 16
              }
            },
            {
              "name": "local_account",
              "path": [
                "command",
                "local_account"
              ],
              "value_kind": {
                "kind": "lower_hex",
                "bytes": 32
              }
            }
          ]
        },
        {
          "id": "urn:marmish:local-command-client:transition:command_room_uncertain",
          "when": [
            {
              "path": [
                "ok"
              ],
              "equals": true
            },
            {
              "path": [
                "result"
              ],
              "equals": null
            },
            {
              "path": [
                "error"
              ],
              "equals": null
            },
            {
              "path": [
                "command",
                "state"
              ],
              "equals": "failure"
            },
            {
              "path": [
                "command",
                "category"
              ],
              "equals": "command_room_uncertain"
            }
          ],
          "effect": {
            "kind": "exit",
            "status": 255,
            "stderr": "marmish: command_room_uncertain"
          }
        },
        {
          "id": "urn:marmish:local-command-client:transition:command_room_capacity",
          "when": [
            {
              "path": [
                "ok"
              ],
              "equals": true
            },
            {
