{
  "format": "oddlang-json-wire-schema-v1",
  "id": "urn:marmish:copy:launch-contract",
  "types": [
    {
      "kind": "external",
      "id": "urn:marmish:copy:AttemptMode"
    },
    {
      "kind": "external",
      "id": "urn:marmish:copy:Direction"
    },
    {
      "kind": "record",
      "id": "urn:marmish:copy:launch",
      "fields": [
        {
          "id": "urn:marmish:copy:launch:field:version",
          "name": "version",
          "type": {
            "kind": "unsigned",
            "bits": 32
          }
        },
        {
          "id": "urn:marmish:copy:launch:field:mode",
          "name": "mode",
          "type": {
            "kind": "ref",
            "id": "urn:marmish:copy:AttemptMode"
          }
        },
        {
          "id": "urn:marmish:copy:launch:field:transfer",
          "name": "transfer",
          "type": {
            "kind": "lower-hex",
            "bytes": 32,
            "diagnostic": "hex"
          }
        },
        {
          "id": "urn:marmish:copy:launch:field:client",
          "name": "client",
          "type": {
            "kind": "lower-hex",
            "bytes": 32,
            "diagnostic": "hex"
          }
        },
        {
          "id": "urn:marmish:copy:launch:field:server",
          "name": "server",
          "type": {
            "kind": "lower-hex",
            "bytes": 32,
            "diagnostic": "hex"
          }
        },
        {
          "id": "urn:marmish:copy:launch:field:direction",
          "name": "direction",
          "type": {
            "kind": "ref",
            "id": "urn:marmish:copy:Direction"
          }
        },
        {
          "id": "urn:marmish:copy:launch:field:source",
          "name": "source",
          "type": {
            "kind": "bounded-base64",
            "policy": {
              "maxBytes": 4096,
              "encodedLimitMessage": "stream capacity reached",
              "decodedLimitMessage": "invalid stream input: base64",
              "syntaxMessage": "invalid stream input: base64"
            }
          }
        },
        {
          "id": "urn:marmish:copy:launch:field:destination",
          "name": "destination",
          "type": {
            "kind": "bounded-base64",
            "policy": {
              "maxBytes": 4096,
              "encodedLimitMessage": "stream capacity reached",
              "decodedLimitMessage": "invalid stream input: base64",
              "syntaxMessage": "invalid stream input: base64"
            }
          }
        },
        {
          "id": "urn:marmish:copy:launch:field:overwrite",
          "name": "overwrite",
          "type": {
            "kind": "bool"
          }
        },
        {
          "id": "urn:marmish:copy:launch:field:preserve_mode",
          "name": "preserve_mode",
          "type": {
            "kind": "bool"
          }
        },
        {
          "id": "urn:marmish:copy:launch:field:preserve_mtime",
          "name": "preserve_mtime",
          "type": {
            "kind": "bool"
          }
        }
      ]
    }
  ],
  "guards": [
    {
      "id": "urn:marmish:copy:launch:guard:version",
      "owner": "urn:marmish:copy:launch",
      "require": {
        "field": "urn:marmish:copy:launch:field:version",
        "kind": "unsigned-range",
        "minimum": 1,
        "maximum": 1
      },
      "error": "urn:marmish:copy:copy_version"
    },
    {
      "id": "urn:marmish:copy:launch:guard:source-length",
      "owner": "urn:marmish:copy:launch",
      "require": {
        "field": "urn:marmish:copy:launch:field:source",
        "kind": "count",
        "minimum": 1,
        "maximum": 4096
      },
      "error": "urn:marmish:copy:copy_path"
    },
    {
      "id": "urn:marmish:copy:launch:guard:source-content",
      "owner": "urn:marmish:copy:launch",
      "require": {
        "field": "urn:marmish:copy:launch:field:source",
        "kind": "excludes-byte",
        "byte": 0
      },
      "error": "urn:marmish:copy:copy_path"
    },
    {
      "id": "urn:marmish:copy:launch:guard:destination-length",
      "owner": "urn:marmish:copy:launch",
      "require": {
        "field": "urn:marmish:copy:launch:field:destination",
        "kind": "count",
        "minimum": 1,
        "maximum": 4096
      },
      "error": "urn:marmish:copy:copy_path"
    },
    {
      "id": "urn:marmish:copy:launch:guard:destination-content",
      "owner": "urn:marmish:copy:launch",
      "require": {
        "field": "urn:marmish:copy:launch:field:destination",
        "kind": "excludes-byte",
        "byte": 0
      },
      "error": "urn:marmish:copy:copy_path"
    }
  ]
}
