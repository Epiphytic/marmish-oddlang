    },
    {
      "id": "urn:marmish:contract:native-cli:release-info:version",
      "wire": "version",
      "source": {
        "kind": "package-version"
      }
    },
    {
      "id": "urn:marmish:contract:native-cli:release-info:target",
      "wire": "target",
      "source": {
        "kind": "build-target"
      }
    },
    {
      "id": "urn:marmish:contract:native-cli:release-info:commit",
      "wire": "commit",
      "source": {
        "kind": "revision",
        "value": "af54339d250290490d62d4475a77539b7e739071"
      }
    },
    {
      "id": "urn:marmish:contract:native-cli:release-info:formats",
      "wire": "formats",
      "source": {
        "kind": "unsigned-list",
        "bits": 32,
        "length": 5,
        "value": [
          2,
          7,
          1,
          1,
          1
        ]
      }
